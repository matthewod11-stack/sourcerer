{
  "name": "sourcerer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "eval": "pnpm --filter @sourcerer/cli build && node apps/cli/dist/index.js eval --mock",
